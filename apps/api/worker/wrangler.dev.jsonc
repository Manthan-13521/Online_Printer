{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "printgo-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "development",
    "ADMIN_ALLOWED_ORIGIN": "http://localhost:5174",
    "CUSTOMER_ALLOWED_ORIGIN": "http://localhost:5173",
    "R2_ACCOUNT_ID": "local-r2-not-configured",
    "R2_BUCKET_NAME": "printgo-pdfs-local",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "printgo-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "printgo-pdfs-local",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_ROOM",
        "class_name": "AgentRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["AgentRoom"],
    },
  ],
}
