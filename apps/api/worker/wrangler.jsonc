{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "printgo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Production must bind the shop-owned DB and private PDF_BUCKET and set the
  // environment/secrets documented in docs/CUSTOMER_UPLOAD.md before deploy.
  "observability": {
    "enabled": true,
  },
}
