{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "printgo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "production",
    "CUSTOMER_ALLOWED_ORIGIN": "https://printgo-customer.pages.dev",
    "ADMIN_ALLOWED_ORIGIN": "https://printgo-admin.pages.dev",
    "R2_ACCOUNT_ID": "<CLOUDFLARE_ACCOUNT_ID>",
    "R2_BUCKET_NAME": "printgo-pdfs",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "printgo-production",
      "database_id": "<SHOP_D1_DATABASE_ID>",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "printgo-pdfs",
    },
  ],
}
